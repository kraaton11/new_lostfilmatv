<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security policy.

    The app talks to lostfilm.today, GitHub and the auth bridge over HTTPS. The only
    legitimate cleartext traffic is the local TorrServe HTTP endpoint (default
    http://127.0.0.1:8090, used to play torrents). Everything else must be HTTPS.

    Before this change the manifest set android:usesCleartextTraffic="true" globally,
    which permitted cleartext to ANY host. This config narrows cleartext down to the
    loopback host so the security posture is no longer "allow http everywhere".

    If you run TorrServe on another device (e.g. http://192.168.1.50:8090), add that
    host to the domain-config below — otherwise its cleartext connection will be blocked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
